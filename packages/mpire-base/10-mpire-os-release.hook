# Keep MpireOS identity when the "filesystem" package installs or upgrades.
# Named 10-* so it runs before 90-mkinitcpio-install.hook (hooks run in name order).
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Applying MpireOS os-release...
When = PostTransaction
Exec = /usr/lib/mpireos/mpire-os-release
