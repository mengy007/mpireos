# Maintainer: MpireOS contributors
pkgname=mpire-base
pkgver=0.1.0
pkgrel=2
pkgdesc="MpireOS identity, defaults, and automatic updates"
arch=('any')
url="https://github.com/mengy007/mpireos"
license=('GPL-3.0-or-later')
depends=('pacman' 'curl' 'sudo' 'snapper' 'snap-pac' 'grub-btrfs' 'mpire-keyring')
optdepends=('flatpak: update Flatpak apps too')
backup=('etc/mpireos/update.conf' 'etc/pacman.d/mpire-snapshot'
        'etc/sddm.conf.d/20-mpire-wayland.conf')
install=mpire-base.install
source=('mpire-os-release' '90-mpire-os-release.hook' 'mpire-update' 'mpire-update.service'
        'mpire-update.timer' 'mpireos.preset' 'update.conf' 'snapshot'
        '20-mpire-wayland.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 mpire-os-release "$pkgdir/usr/lib/mpireos/mpire-os-release"
    install -Dm644 90-mpire-os-release.hook "$pkgdir/usr/share/libalpm/hooks/90-mpire-os-release.hook"
    install -Dm755 mpire-update "$pkgdir/usr/bin/mpire-update"
    install -Dm644 mpire-update.service "$pkgdir/usr/lib/systemd/system/mpire-update.service"
    install -Dm644 mpire-update.timer "$pkgdir/usr/lib/systemd/system/mpire-update.timer"
    install -Dm644 mpireos.preset "$pkgdir/usr/lib/systemd/system-preset/80-mpireos.preset"
    install -Dm644 update.conf "$pkgdir/etc/mpireos/update.conf"
    printf '# Managed by mpire-update.\nServer = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' \
        "$(tr -d '[:space:]' < snapshot)" > mpire-snapshot
    install -Dm644 mpire-snapshot "$pkgdir/etc/pacman.d/mpire-snapshot"
    install -Dm644 20-mpire-wayland.conf "$pkgdir/etc/sddm.conf.d/20-mpire-wayland.conf"
}
