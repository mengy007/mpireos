# Maintainer: MpireOS contributors
pkgname=mpire-base
pkgver=0.2.0
pkgrel=1
pkgdesc="MpireOS identity, defaults, automatic updates, and snapshot rollback"
arch=('any')
url="https://github.com/mengy007/mpireos"
license=('GPL-3.0-or-later')
depends=('pacman' 'curl' 'sudo' 'btrfs-progs' 'snapper' 'snap-pac' 'grub' 'mpire-keyring')
optdepends=('flatpak: update Flatpak apps too')
backup=('etc/mpireos/update.conf' 'etc/pacman.d/mpire-snapshot' 'etc/pacman.d/mpire-repo'
        'etc/sddm.conf.d/20-mpire-wayland.conf')
install=mpire-base.install
source=('mpire-os-release' '90-mpire-os-release.hook' 'mpire-update' 'mpire-update.service'
        'mpire-update.timer' 'mpireos.preset' 'update.conf' 'snapshot' 'mpire-repo'
        '20-mpire-wayland.conf' 'mpire-rollback' 'mpire-keep-kernel' 'mpire-boot-menu'
        '41_mpire_snapshots' '00-mpire-keep-kernel.hook' 'zzz-mpire-boot-menu.hook'
        'snapper-cleanup-mpireos.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 mpire-os-release "$pkgdir/usr/lib/mpireos/mpire-os-release"
    install -Dm644 90-mpire-os-release.hook "$pkgdir/usr/share/libalpm/hooks/90-mpire-os-release.hook"
    install -Dm755 mpire-update "$pkgdir/usr/bin/mpire-update"
    install -Dm644 mpire-update.service "$pkgdir/usr/lib/systemd/system/mpire-update.service"
    install -Dm644 mpire-update.timer "$pkgdir/usr/lib/systemd/system/mpire-update.timer"
    install -Dm644 mpireos.preset "$pkgdir/usr/lib/systemd/system-preset/80-mpireos.preset"
    install -Dm644 update.conf "$pkgdir/etc/mpireos/update.conf"
    printf '# Managed by mpire-update.\nServer = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' \
        "$(tr -d '[:space:]' < snapshot)" > mpire-snapshot
    install -Dm644 mpire-snapshot "$pkgdir/etc/pacman.d/mpire-snapshot"
    install -Dm644 mpire-repo "$pkgdir/etc/pacman.d/mpire-repo"

    # Snapshot rollback: boot menu entries, kept kernels, and mpire-rollback.
    install -Dm755 mpire-rollback "$pkgdir/usr/bin/mpire-rollback"
    install -Dm755 mpire-keep-kernel "$pkgdir/usr/lib/mpireos/mpire-keep-kernel"
    install -Dm755 mpire-boot-menu "$pkgdir/usr/lib/mpireos/mpire-boot-menu"
    install -Dm755 41_mpire_snapshots "$pkgdir/etc/grub.d/41_mpire_snapshots"
    install -Dm644 00-mpire-keep-kernel.hook "$pkgdir/usr/share/libalpm/hooks/00-mpire-keep-kernel.hook"
    install -Dm644 zzz-mpire-boot-menu.hook "$pkgdir/usr/share/libalpm/hooks/zzz-mpire-boot-menu.hook"
    install -Dm644 snapper-cleanup-mpireos.conf \
        "$pkgdir/usr/lib/systemd/system/snapper-cleanup.service.d/mpireos.conf"

    install -Dm644 20-mpire-wayland.conf "$pkgdir/etc/sddm.conf.d/20-mpire-wayland.conf"
}
