#!/bin/bash
# mpire-update: keep MpireOS up to date.
#
# MpireOS does not follow live Arch mirrors. Each channel points at a dated Arch
# snapshot that MpireOS has tested. Updating means:
#   1. ask MpireOS which snapshot the channel is on now,
#   2. point pacman at that snapshot,
#   3. upgrade (snap-pac takes a Btrfs snapshot before and after),
#   4. update Flatpak apps.
# If anything goes wrong, boot the "before" snapshot from the boot menu.
set -euo pipefail

CONF=/etc/mpireos/update.conf
MIRRORLIST=/etc/pacman.d/mpire-snapshot
STATE_DIR=/var/lib/mpire-update
CHANNEL=stable
RELEASE_URL=https://github.com/mengy007/mpireos/releases/download/repo
AUTO=yes
[[ -r $CONF ]] && . "$CONF"

usage() {
    cat <<USAGE
Usage: mpire-update [--check] [--auto] [--yes]

  (no option)  Check for updates and install them, asking first
  --check      Only report whether updates are available
  --yes        Install without asking
  --auto       Background mode used by mpire-update.timer (implies --yes;
               does nothing if AUTO=no in $CONF)

Channel: $CHANNEL (set CHANNEL in $CONF)
USAGE
}

mode=interactive
for arg in "$@"; do
    case "$arg" in
        --check) mode=check ;;
        --yes|-y) mode=yes ;;
        --auto) mode=auto ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done

log() { echo "mpire-update: $*"; }
die() { echo "mpire-update: $*" >&2; exit 1; }

if [[ $mode == auto && ${AUTO,,} != yes ]]; then
    log "automatic updates are turned off (AUTO=no in $CONF)"
    exit 0
fi
[[ $EUID -eq 0 || $mode == check ]] || exec sudo "$0" "$@"

current="$(sed -n 's|^Server = .*/repos/\([0-9]\{4\}/[0-9]\{2\}/[0-9]\{2\}\)/.*|\1|p' "$MIRRORLIST" | head -n1)"
[[ -n $current ]] || die "can't read the current snapshot from $MIRRORLIST"

latest="$(curl -fsSL --retry 3 --max-time 30 "$RELEASE_URL/$CHANNEL.channel" | tr -d '[:space:]')" \
    || die "can't reach MpireOS updates ($RELEASE_URL). Are you online?"
[[ $latest =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "unexpected channel data: '$latest'"

# Never move backwards: a channel only ever moves forward in time.
if [[ ${latest//\//} < ${current//\//} ]]; then
    latest="$current"
fi

if [[ $mode == check ]]; then
    if [[ $latest != "$current" ]]; then
        echo "Update available: $current -> $latest ($CHANNEL)"
        exit 100
    fi
    echo "MpireOS is up to date on $CHANNEL ($current)."
    exit 0
fi

if [[ $latest != "$current" ]]; then
    log "moving $CHANNEL from $current to $latest"
else
    log "on the newest $CHANNEL snapshot ($current); checking MpireOS packages"
fi

if [[ $mode == interactive ]]; then
    read -r -p "Install updates now? [Y/n] " answer
    [[ -z $answer || ${answer,,} == y* ]] || exit 0
fi

mkdir -p "$STATE_DIR"
cp -a "$MIRRORLIST" "$STATE_DIR/mpire-snapshot.previous"
printf '# Managed by mpire-update. Channel: %s\nServer = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' \
    "$CHANNEL" "$latest" > "$MIRRORLIST"

restore() {
    cp -a "$STATE_DIR/mpire-snapshot.previous" "$MIRRORLIST"
    date -Is > "$STATE_DIR/last-failure"
    die "update failed; nothing was changed. Details: journalctl -u mpire-update"
}

# Keyrings first, so packages signed by new keys verify.
pacman -Sy --noconfirm --needed archlinux-keyring mpire-keyring || restore
if ! pacman -Su --noconfirm; then
    # pacman may have partly upgraded; the "pre" snapshot from snap-pac is the way back.
    date -Is > "$STATE_DIR/last-failure"
    die "upgrade failed part way. Boot the snapshot taken before this update from the boot menu to undo it."
fi

if command -v flatpak >/dev/null; then
    flatpak update --system --noninteractive -y || log "Flatpak updates failed; will retry next time"
fi

echo "$latest" > "$STATE_DIR/snapshot"
date -Is > "$STATE_DIR/last-success"
rm -f "$STATE_DIR/last-failure"
if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
    log "done. Restart to finish updating the system kernel."
else
    log "done."
fi
