# MpireOS window defaults: light, quiet title bars with buttons on the right.
[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

[Plugins]
blurEnabled=true
contrastEnabled=true

[Windows]
BorderlessMaximizedWindows=false

# Tapping Meta opens MpireOS's launcher (mpire-shell), not Plasma's menu.
[ModifierOnlyShortcuts]
Meta=org.mpireos.Shell,/org/mpireos/Shell,org.mpireos.Shell,ToggleLauncher
