# MpireOS window defaults: Mpire window frames (desktop/decoration), with
# minimize, maximize and close on the right. KWin falls back to Breeze if
# the frames can't load.
[org.kde.kdecoration2]
library=org.mpireos.decoration
theme=
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

[Plugins]
blurEnabled=true
contrastEnabled=true

# Frosted glass (window frames, app windows, panels): a lighter blur than
# KWin's default, so shapes behind still show softly, and no noise.
[Effect-blur]
BlurStrength=7
NoiseStrength=0

[Windows]
BorderlessMaximizedWindows=false

# Three workspaces, shown as dots in the top bar.
[Desktops]
Number=3
Rows=1
Name_1=Workspace 1
Name_2=Workspace 2
Name_3=Workspace 3

# Tapping Meta opens MpireOS's launcher (mpire-shell), not Plasma's menu.
[ModifierOnlyShortcuts]
Meta=org.mpireos.Shell,/org/mpireos/Shell,org.mpireos.Shell,ToggleLauncher
