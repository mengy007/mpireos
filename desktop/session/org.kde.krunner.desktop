# MpireOS: takes the place of KRunner's entry, so its shortcuts (Alt+Space,
# Alt+F2, Search) and anything else that starts "KRunner" open MpireOS's
# universal search instead. Installed under /usr/local/share, which comes before
# /usr/share in XDG_DATA_DIRS, so it shadows the file from the krunner package.
# Meta+Space is in org.mpireos.search.desktop.
[Desktop Entry]
Type=Application
Name=MpireOS Search
Comment=Search apps, files, settings, and more
Exec=mpire-shell --toggle search
Icon=search
NoDisplay=true
X-KDE-Shortcuts=Alt+Space,Alt+F2,Search
