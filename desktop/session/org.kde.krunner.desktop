# MpireOS: takes the place of KRunner's entry, so its shortcuts (Alt+Space,
# Alt+F2, Search) and anything else that starts "KRunner" open MpireOS's
# launcher instead. Installed under /usr/local/share, which comes before
# /usr/share in XDG_DATA_DIRS, so it shadows the file from the krunner package.
[Desktop Entry]
Type=Application
Name=MpireOS Launcher
Comment=Search apps and settings
Exec=mpire-shell --toggle launcher
Icon=search
NoDisplay=true
X-KDE-Shortcuts=Alt+Space,Alt+F2,Search
