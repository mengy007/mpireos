#!/bin/bash
# Reports whether the graphical session came up, for CI boot tests.
#   Live ISO:         waits for the live user's Plasma shell -> MPIREOS_DESKTOP_OK
#   Installed system: waits for the SDDM login screen        -> MPIREOS_GREETER_OK
# Markers go to the kernel log and the serial console; scripts/smoke-test.sh reads them.
report() {
    echo "<2>$1" > /dev/kmsg 2>/dev/null || true
    [ -w /dev/ttyS0 ] && echo "$1" > /dev/ttyS0 2>/dev/null || true
}
if id live &>/dev/null; then
    ok="MPIREOS_DESKTOP_OK"; check() { pgrep -u live -x plasmashell >/dev/null; }
else
    ok="MPIREOS_GREETER_OK"; check() { pgrep -f sddm-greeter >/dev/null; }
fi
for _ in $(seq 1 240); do
    if check; then report "$ok"; exit 0; fi
    sleep 1
done
report "MPIREOS_DESKTOP_FAIL"
systemctl --failed --no-legend --plain 2>/dev/null | while read -r line; do report "MPIREOS_FAILED_UNIT $line"; done
journalctl -b -u display-manager --no-pager -n 30 2>/dev/null | while read -r line; do report "MPIREOS_SDDM $line"; done
exit 1
