#!/bin/bash
# Reports whether the graphical session came up, for CI boot tests.
#   Live ISO:         waits for Mpire Desktop's shell         -> MPIREOS_DESKTOP_OK
#                     then for Mpire Setup to open by itself  -> MPIREOS_SETUP_OK
#                     (skipped for unattended installs)
#   Installed system: waits for the MpireOS login screen      -> MPIREOS_GREETER_OK
#                     (MPIREOS_GREETER_FAIL if its theme has QML errors)
# Markers go to the kernel log and the serial console; scripts/smoke-test.sh reads them.
report() {
    echo "<2>$1" > /dev/kmsg 2>/dev/null || true
    [ -w /dev/ttyS0 ] && echo "$1" > /dev/ttyS0 2>/dev/null || true
}
# The MpireOS login screen logs its QML errors to the journal; any error means
# SDDM may be showing its fallback theme instead.
greeter_errors() {
    journalctl -b --no-pager 2>/dev/null | grep -a -i 'sddm/themes/mpireos' | grep -a -i -e error -e 'is not' -e 'not installed' -e 'not found'
}
if id live &>/dev/null; then
    # Mpire Desktop's shell, running in place of plasmashell, for 20 seconds straight.
    alive=0
    check() {
        if pgrep -u live -x mpire-shell >/dev/null; then alive=$((alive + 1)); else alive=0; fi
        [ $alive -ge 20 ]
    }
    ok="MPIREOS_DESKTOP_OK"
else
    check() { pgrep -f sddm-greeter >/dev/null && sleep 10 && pgrep -f sddm-greeter >/dev/null; }
    ok="MPIREOS_GREETER_OK"
fi
setup_check() {
    id live &>/dev/null || return 0
    grep -q 'mpire\.autoinstall' /proc/cmdline && return 0
    # It must start and keep running (a QML error would make it exit at once).
    local alive=0
    for _ in $(seq 1 150); do
        if pgrep -u live -x mpire-setup >/dev/null; then alive=$((alive + 1)); else alive=0; fi
        if [ $alive -ge 20 ]; then report "MPIREOS_SETUP_OK"; setup_log; return 0; fi
        sleep 1
    done
    report "MPIREOS_SETUP_FAIL"
    setup_log
    journalctl -b _UID="$(id -u live)" --no-pager -n 60 2>/dev/null | grep -i -e setup -e qml -e autostart \
        | while read -r line; do report "MPIREOS_SETUP_LOG $line"; done
    return 1
}
# CI only (QEMU started with -fw_cfg name=opt/mpireos/ci): once the test has
# closed the installer, open an app window so its title bar and colors show up
# in the test's screenshot.
ci_open_app() {
    [ -e /sys/firmware/qemu_fw_cfg/by_name/opt/mpireos/ci/raw ] || return 0
    id live &>/dev/null || return 0
    sleep 30
    # Start it with the desktop shell's own environment, so it reaches the same
    # Wayland display and session bus.
    local shell_pid; shell_pid="$(pgrep -u live -x mpire-shell | head -n 1)"
    local -a shell_env=()
    [ -n "$shell_pid" ] && mapfile -d '' shell_env < "/proc/$shell_pid/environ"
    runuser -u live -- env -i "${shell_env[@]}" systemsettings >/tmp/ci-app.log 2>&1 &
    sleep 15
    if pgrep -u live -x systemsettings >/dev/null; then report "MPIREOS_APP_RUNNING"; else report "MPIREOS_APP_EXITED"; fi
    report "MPIREOS_APP_LOG env: $(printf '%s\n' "${shell_env[@]}" | grep -a -e '^WAYLAND_DISPLAY=' -e '^QT_QPA_PLATFORM=' | tr '\n' ' ')"
    tail -n 15 /tmp/ci-app.log 2>/dev/null | while read -r line; do report "MPIREOS_APP_LOG $line"; done
    report "MPIREOS_APP_OPENED"

    # Then Mpire Desktop's own panels, one at a time; the test screenshots each.
    as_live() { runuser -u live -- env -i "${shell_env[@]}" "$@"; }
    sleep 20
    pkill -u live -x systemsettings
    as_live notify-send -a "Mpire Setup" -i system-software-install -t 60000 \
        "Welcome to MpireOS" "Your desktop is ready. Press Alt+Space to find anything." >/tmp/ci-notify.log 2>&1 \
        || tail -n 5 /tmp/ci-notify.log | while read -r line; do report "MPIREOS_NOTIFY_LOG $line"; done
    as_live notify-send -a "Discover" -i plasmadiscover -t 60000 "Updates are ready" "MpireOS takes a snapshot before installing them."
    sleep 5
    report "MPIREOS_NOTIFY_SHOWN"
    sleep 20
    as_live mpire-shell --show quick-settings && report "MPIREOS_QUICK_SHOWN" || report "MPIREOS_QUICK_FAILED"
    sleep 20
    as_live mpire-shell --show notifications && report "MPIREOS_CENTER_SHOWN" || report "MPIREOS_CENTER_FAILED"
    sleep 20
    as_live mpire-shell --hide
    report "MPIREOS_SHORTCUT_LOG XDG_DATA_DIRS=$(printf '%s\n' "${shell_env[@]}" | grep -a '^XDG_DATA_DIRS=' | cut -d= -f2-)"
    report "MPIREOS_SHORTCUT_LOG $(ls /usr/share/kglobalaccel /usr/local/share/kglobalaccel 2>/dev/null | grep -i -e runner -e mpire | tr '\n' ' ')"
    grep -a -i -A2 'krunner' "/home/live/.config/kglobalshortcutsrc" 2>/dev/null | head -n 6 \
        | while read -r line; do report "MPIREOS_SHORTCUT_LOG $line"; done
    # The test opens the launcher itself with Alt+Space, to check the shortcut.
    report "MPIREOS_PANELS_DONE"
}
setup_log() {
    [ -f /tmp/mpire-setup.log ] || { report "MPIREOS_SETUP_LOG (no output)"; return; }
    tail -n 40 /tmp/mpire-setup.log | while read -r line; do report "MPIREOS_SETUP_LOG $line"; done
}
for _ in $(seq 1 240); do
    if check; then
        if ! id live &>/dev/null && [ -n "$(greeter_errors)" ]; then
            report "MPIREOS_GREETER_FAIL"
            greeter_errors | tail -n 20 | while read -r line; do report "MPIREOS_GREETER_LOG $line"; done
            exit 1
        fi
        report "$ok"
        setup_check || exit 1
        ci_open_app
        exit 0
    fi
    sleep 1
done
if id live &>/dev/null; then
    journalctl -b _UID="$(id -u live)" --no-pager 2>/dev/null | grep -a -i -e mpire-shell -e 'qml' | tail -n 30 \
        | while read -r line; do report "MPIREOS_SHELL_LOG $line"; done
fi
report "MPIREOS_DESKTOP_FAIL"
systemctl --failed --no-legend --plain 2>/dev/null | while read -r line; do report "MPIREOS_FAILED_UNIT $line"; done
journalctl -b -u display-manager --no-pager -n 30 2>/dev/null | while read -r line; do report "MPIREOS_SDDM $line"; done
exit 1
