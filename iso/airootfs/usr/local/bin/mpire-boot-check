#!/bin/bash
# Reports whether the graphical session came up, for CI boot tests.
#   Live ISO:         waits for Mpire Desktop's shell         -> MPIREOS_DESKTOP_OK
#                     then for Mpire Setup to open by itself  -> MPIREOS_SETUP_OK
#                     (skipped for unattended installs)
#   Installed system: waits for the MpireOS login screen      -> MPIREOS_GREETER_OK
#                     (MPIREOS_GREETER_FAIL if its theme has QML errors)
# Markers go to the kernel log and the serial console; scripts/smoke-test.sh reads them.
report() {
    echo "<2>$1" > /dev/kmsg 2>/dev/null || true
    [ -w /dev/ttyS0 ] && echo "$1" > /dev/ttyS0 2>/dev/null || true
}
# Which root this boot uses: the installed system, or a snapshot from the
# "MpireOS snapshots" boot menu (scripts/install-test.sh checks both).
snap="$(grep -o 'mpire\.snapshot=[0-9]*' /proc/cmdline | cut -d= -f2)"
report "MPIREOS_ROOT ${snap:+snapshot $snap}${snap:-system} $(findmnt -no FSTYPE /)"
# The MpireOS login screen logs its QML errors to the journal; any error means
# SDDM may be showing its fallback theme instead.
greeter_errors() {
    journalctl -b --no-pager 2>/dev/null | grep -a -i 'sddm/themes/mpireos' | grep -a -i -e error -e 'is not' -e 'not installed' -e 'not found'
}
if id live &>/dev/null; then
    # Mpire Desktop's shell, running in place of plasmashell, for 20 seconds straight.
    alive=0
    check() {
        if pgrep -u live -x mpire-shell >/dev/null; then alive=$((alive + 1)); else alive=0; fi
        [ $alive -ge 20 ]
    }
    ok="MPIREOS_DESKTOP_OK"
else
    check() { pgrep -f sddm-greeter >/dev/null && sleep 10 && pgrep -f sddm-greeter >/dev/null; }
    ok="MPIREOS_GREETER_OK"
fi
setup_check() {
    id live &>/dev/null || return 0
    grep -q 'mpire\.autoinstall' /proc/cmdline && return 0
    # It must start and keep running (a QML error would make it exit at once).
    local alive=0
    for _ in $(seq 1 150); do
        if pgrep -u live -x mpire-setup >/dev/null; then alive=$((alive + 1)); else alive=0; fi
        if [ $alive -ge 20 ]; then report "MPIREOS_SETUP_OK"; setup_log; return 0; fi
        sleep 1
    done
    report "MPIREOS_SETUP_FAIL"
    setup_log
    journalctl -b _UID="$(id -u live)" --no-pager -n 60 2>/dev/null | grep -i -e setup -e qml -e autostart \
        | while read -r line; do report "MPIREOS_SETUP_LOG $line"; done
    return 1
}
# CI only (QEMU started with -fw_cfg name=opt/mpireos/ci): once the test has
# closed the installer, open two app windows (Konsole, then Dolphin in
# front of it) so the window frames, focused and not, and the app colors show
# up in the test's screenshot.
ci_open_app() {
    [ -e /sys/firmware/qemu_fw_cfg/by_name/opt/mpireos/ci/raw ] || return 0
    id live &>/dev/null || return 0
    sleep 30
    # Start it with the desktop shell's own environment, so it reaches the same
    # Wayland display and session bus.
    local shell_pid; shell_pid="$(pgrep -u live -x mpire-shell | head -n 1)"
    local -a shell_env=()
    [ -n "$shell_pid" ] && mapfile -d '' shell_env < "/proc/$shell_pid/environ"
    runuser -u live -- env -i "${shell_env[@]}" konsole >/tmp/ci-konsole.log 2>&1 &
    sleep 6
    runuser -u live -- env -i "${shell_env[@]}" MPIRE_GLASS_DEBUG=1 QT_FORCE_STDERR_LOGGING=1 dolphin >/tmp/ci-app.log 2>&1 &
    sleep 15
    report "MPIREOS_APP_LOG frames: $(ls /usr/lib/qt6/plugins/org.kde.kdecoration3/ 2>/dev/null | tr '\n' ' ')"
    report "MPIREOS_APP_LOG style: $(ls /usr/lib/qt6/plugins/styles/ 2>/dev/null | tr '\n' ' ')"
    journalctl -b _UID="$(id -u live)" --no-pager 2>/dev/null | grep -i -e 'decoration' | tail -n 5 \
        | while read -r line; do report "MPIREOS_APP_LOG $line"; done
    if pgrep -u live -x dolphin >/dev/null; then report "MPIREOS_APP_RUNNING"; else report "MPIREOS_APP_EXITED"; fi
    report "MPIREOS_APP_LOG env: $(printf '%s\n' "${shell_env[@]}" | grep -a -e '^WAYLAND_DISPLAY=' -e '^QT_QPA_PLATFORM=' | tr '\n' ' ')"
    tail -n 15 /tmp/ci-app.log 2>/dev/null | while read -r line; do report "MPIREOS_APP_LOG $line"; done
    report "MPIREOS_APP_OPENED"

    # Then Mpire Desktop's own panels, one at a time; the test screenshots each.
    as_live() { runuser -u live -- env -i "${shell_env[@]}" "$@"; }
    ci_splash
    sleep 20
    pkill -u live -x dolphin
    pkill -u live -x konsole
    as_live notify-send -a "Mpire Setup" -i system-software-install -t 60000 \
        "Welcome to MpireOS" "Your desktop is ready. Press Alt+Space to find anything." >/tmp/ci-notify.log 2>&1 \
        || tail -n 5 /tmp/ci-notify.log | while read -r line; do report "MPIREOS_NOTIFY_LOG $line"; done
    as_live notify-send -a "Discover" -i plasmadiscover -t 60000 "Updates are ready" "MpireOS takes a snapshot before installing them."
    sleep 5
    report "MPIREOS_NOTIFY_SHOWN"
    sleep 20
    as_live mpire-shell --show quick-settings && report "MPIREOS_QUICK_SHOWN" || report "MPIREOS_QUICK_FAILED"
    sleep 20
    as_live mpire-shell --show notifications && report "MPIREOS_CENTER_SHOWN" || report "MPIREOS_CENTER_FAILED"
    sleep 20
    as_live mpire-shell --hide
    report "MPIREOS_SHORTCUT_LOG XDG_DATA_DIRS=$(printf '%s\n' "${shell_env[@]}" | grep -a '^XDG_DATA_DIRS=' | cut -d= -f2-)"
    report "MPIREOS_SHORTCUT_LOG $(ls /usr/share/kglobalaccel /usr/local/share/kglobalaccel 2>/dev/null | grep -i -e runner -e mpire | tr '\n' ' ')"
    grep -a -i -A2 'krunner' "/home/live/.config/kglobalshortcutsrc" 2>/dev/null | head -n 6 \
        | while read -r line; do report "MPIREOS_SHORTCUT_LOG $line"; done
    # Apps with tray icons, for the top bar's system tray: two that use
    # StatusNotifierItem (as Qt, KDE, Electron, and Ayatana apps do), and one
    # old-style XEmbed icon, which reaches the tray through xembedsniproxy.
    local tray_test=/usr/lib/mpire-desktop/mpire-tray-test
    as_live "$tray_test" --name Sync --color "#5B8DEF" >/tmp/ci-tray-sync.log 2>&1 &
    sleep 2
    as_live "$tray_test" --name Chat --color "#7C66D6" >/tmp/ci-tray-chat.log 2>&1 &
    sleep 2
    as_live env DBUS_SESSION_BUS_ADDRESS=disabled: QT_QPA_PLATFORM=xcb "$tray_test" --name Legacy --color "#E6B072" \
        >/tmp/ci-tray-legacy.log 2>&1 &
    # Some files for universal search to find.
    runuser -u live -- bash -c '
        cd /home/live && mkdir -p Documents/Work Pictures
        printf "%%PDF-1.4\n%%%%EOF\n" > "Documents/Quarterly report.pdf"
        printf "Revenue,Costs\n10,4\n" > "Documents/Work/report-q3-figures.csv"
        mkdir -p "Documents/Report drafts"
        pic="$(find /usr/share/wallpapers -name "*.png" -size +100k 2>/dev/null | head -n 1)"
        [ -n "$pic" ] && cp "$pic" "Pictures/Report cover.png"'
    sleep 8
    report "MPIREOS_TRAY_LOG xembedsniproxy: $(pgrep -u live -x xembedsniproxy >/dev/null && echo running || echo 'not running')"
    report "MPIREOS_TRAY_LOG watcher: $(as_live busctl --user status org.kde.StatusNotifierWatcher 2>/dev/null | grep -m1 -e '^Comm=' || echo none)"
    for f in sync chat legacy; do
        tail -n 3 "/tmp/ci-tray-$f.log" 2>/dev/null | while read -r line; do report "MPIREOS_TRAY_LOG $f: $line"; done
    done
    ci_ai
    # The test opens the launcher itself with Alt+Space, to check the shortcut.
    report "MPIREOS_PANELS_DONE"
}
# The splash after login: which one Plasma picked for the live user, and
# whether it closed when the desktop was up (systemd stops it after 40
# seconds otherwise, and logs that it timed out), without a second splash
# started by D-Bus activation.
ci_splash() {
    local cfg; cfg="$(as_live kreadconfig6 --file ksplashrc --group KSplash --key Engine 2>&1) $(as_live kreadconfig6 --file ksplashrc --group KSplash --key Theme 2>&1)"
    report "MPIREOS_SPLASH_LOG config: $cfg"
    report "MPIREOS_SPLASH_LOG kdedefaults: $(tr '\n' ' ' < /home/live/.config/kdedefaults/ksplashrc 2>/dev/null)"
    journalctl -b _UID="$(id -u live)" --no-pager 2>/dev/null | grep -a -i ksplash | tail -n 10 \
        | while read -r line; do report "MPIREOS_SPLASH_LOG $line"; done
    if [ "$cfg" = "KSplashQML org.mpireos.desktop" ] \
        && [ -f /usr/share/plasma/look-and-feel/org.mpireos.desktop/contents/splash/Splash.qml ] \
        && ! journalctl -b _UID="$(id -u live)" --no-pager 2>/dev/null | grep -a 'plasma-ksplash.service' \
            | grep -q -i -e 'timed out' -e 'Failed with result' -e 'Failed to start' \
        && ! journalctl -b _UID="$(id -u live)" --no-pager 2>/dev/null | grep -a -q 'Started dbus-.*org.kde.KSplash'; then
        report "MPIREOS_SPLASH_OK"
    else
        report "MPIREOS_SPLASH_FAIL"
    fi
}
# MpireOS's built-in AI (mpire-ai), set up as a person would from the command
# line: a cloud key is stored and removed (to see where keys are kept), then
# the network is searched for model servers. scripts/smoke-test.sh runs a
# stand-in model server on the host, which QEMU's network shows at 10.0.2.2,
# so it is found by a real search of the local network and then answers.
ci_ai() {
    as_live mpire-ai add anthropic >/dev/null 2>&1
    as_live sh -c 'echo sk-ci-not-a-real-key | mpire-ai key set anthropic' 2>&1 | while read -r line; do report "MPIREOS_AI_LOG key: $line"; done
    report "MPIREOS_AI_LOG key storage: $(as_live mpire-ai --json key status anthropic 2>&1)"
    report "MPIREOS_AI_LOG key files: $(ls -l /home/live/.local/share/mpire-ai/keys 2>&1 | tail -n +2 | awk '{print $1, $NF}' | tr '\n' ' ')"
    grep -q sk-ci-not-a-real-key -r /home/live/.config/mpire-ai /home/live/.local/share/mpire-ai 2>/dev/null \
        && report "MPIREOS_AI_LOG key: FOUND IN PLAIN TEXT" || report "MPIREOS_AI_LOG key: not stored in plain text"
    as_live mpire-ai remove anthropic >/dev/null 2>&1
    local started=$SECONDS
    as_live mpire-ai discover --network --add 2>&1 | while read -r line; do report "MPIREOS_AI_LOG discover: $line"; done
    report "MPIREOS_AI_LOG discover took $((SECONDS - started))s"
    as_live mpire-ai status 2>&1 | while read -r line; do report "MPIREOS_AI_LOG status: $line"; done
    as_live mpire-ai ask "hello from the boot test" 2>&1 | head -c 200 | while read -r line; do report "MPIREOS_AI_LOG ask: $line"; done
    # The gateway for apps, started by its socket on first use.
    report "MPIREOS_AI_LOG gateway: $(as_live sh -c 'curl -s --max-time 20 --unix-socket "$XDG_RUNTIME_DIR/mpire-ai.sock" http://localhost/v1/models' 2>&1 | head -c 300)"
    if as_live mpire-ai status 2>/dev/null | grep -q -e '^\* .*10-0-2-2' -e '^\* .*10\.0\.2\.2'; then report "MPIREOS_AI_READY"; else report "MPIREOS_AI_FAILED"; fi
}
setup_log() {
    [ -f /tmp/mpire-setup.log ] || { report "MPIREOS_SETUP_LOG (no output)"; return; }
    tail -n 40 /tmp/mpire-setup.log | while read -r line; do report "MPIREOS_SETUP_LOG $line"; done
}
for _ in $(seq 1 240); do
    if check; then
        if ! id live &>/dev/null && [ -n "$(greeter_errors)" ]; then
            report "MPIREOS_GREETER_FAIL"
            greeter_errors | tail -n 20 | while read -r line; do report "MPIREOS_GREETER_LOG $line"; done
            exit 1
        fi
        report "$ok"
        setup_check || exit 1
        ci_open_app
        exit 0
    fi
    sleep 1
done
if id live &>/dev/null; then
    journalctl -b _UID="$(id -u live)" --no-pager 2>/dev/null | grep -a -i -e mpire-shell -e 'qml' | tail -n 30 \
        | while read -r line; do report "MPIREOS_SHELL_LOG $line"; done
fi
report "MPIREOS_DESKTOP_FAIL"
systemctl --failed --no-legend --plain 2>/dev/null | while read -r line; do report "MPIREOS_FAILED_UNIT $line"; done
journalctl -b -u display-manager --no-pager -n 30 2>/dev/null | while read -r line; do report "MPIREOS_SDDM $line"; done
exit 1
