# MpireOS pacman configuration.
#
# [mpire] holds MpireOS's own packages. [core] and [extra] come from a dated Arch
# Linux snapshot chosen by the release channel (/etc/pacman.d/mpire-snapshot,
# managed by mpire-update), not from live Arch mirrors.

[options]
HoldPkg     = pacman glibc
Architecture = auto
CheckSpace
ParallelDownloads = 5
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

[mpire]
# TODO: switch to "Required" once the project signing key exists (packages/mpire-keyring).
SigLevel = Optional TrustedOnly
Server = https://github.com/mengy007/mpireos/releases/download/repo

[core]
Include = /etc/pacman.d/mpire-snapshot

[extra]
Include = /etc/pacman.d/mpire-snapshot
