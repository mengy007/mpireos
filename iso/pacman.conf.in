# MpireOS pacman configuration.
#
# [mpire] holds MpireOS's own packages, from the release channel's repository
# (/etc/pacman.d/mpire-repo). [core] and [extra] come from a dated Arch Linux
# snapshot chosen by the channel (/etc/pacman.d/mpire-snapshot), not from live
# Arch mirrors. mpire-update manages both files.

[options]
HoldPkg     = pacman glibc
Architecture = auto
CheckSpace
ParallelDownloads = 5
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

[mpire]
# Becomes "Required" by itself once the project signing key ships in mpire-keyring
# (iso/build.sh for new installs, mpire-base's upgrade step for existing ones).
SigLevel = Optional TrustedOnly
Include = /etc/pacman.d/mpire-repo

[core]
Include = /etc/pacman.d/mpire-snapshot

[extra]
Include = /etc/pacman.d/mpire-snapshot
